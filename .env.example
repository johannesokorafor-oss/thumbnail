# ---- AI Provider ----
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Models (central config) ----
ANALYSIS_MODEL=gpt-6-astra
ANALYSIS_MODEL_FALLBACK=gpt-5-mini
IMAGE_PROVIDER=openai
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_MODEL_FALLBACK=gpt-image-2.5-flare

# ---- Folders (Windows examples) ----
INPUT_FOLDER=C:\YouTube\Scripts\Incoming
OUTPUT_FOLDER=C:\YouTube\Thumbnails\Generated
ARCHIVE_FOLDER=C:\YouTube\Thumbnails\Archive
FAILED_FOLDER=C:\YouTube\Thumbnails\Failed
REFERENCE_FOLDER=C:\YouTube\ThumbnailReferences

# ---- Generation ----
QUALITY_MODE=BALANCED
# leer / 'auto' = der QUALITY_MODE bestimmt die Qualitaet (FAST=high, BALANCED=xhigh, MAX=max).
# Ein expliziter Wert (low|medium|high|xhigh|max) ueberschreibt den Modus.
IMAGE_QUALITY=auto
IMAGE_SIZE=2560x1440
VARIANT_COUNT=4
MAX_VARIANT_COUNT=6
TEXT_MODE=LOCAL_OVERLAY
DEFAULT_LANGUAGE=de

# ---- Cost control (USD, estimates) ----
# MAX-Modus: 4 Kandidaten in 'max' bei 2560x1440 kosten geschätzt ca. $3 pro Job,
# plus optionale Verfeinerung und Bewertungsaufrufe. Budget entsprechend setzen.
MAX_COST_PER_JOB=8.00
MAX_COST_PER_DAY=40.00

# ---- Misc ----
TEST_MODE=true
PORT=3000
LOG_LEVEL=info
